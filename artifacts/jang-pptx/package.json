{
  "name": "@jang/pptx-engine",
  "version": "1.0.0",
  "description": "Deterministic native editable PowerPoint renderer for structured lecture metadata.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "default": "./dist/lecture-schema.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:schema": "node scripts/copy-schema.mjs",
    "build:demo": "vite build --config vite.config.ts",
    "build": "pnpm clean && pnpm build:lib && pnpm build:types && pnpm build:schema && pnpm build:demo",
    "typecheck:lib": "tsc -p tsconfig.typecheck.json",
    "typecheck:demo": "tsc -p tsconfig.demo.json",
    "typecheck": "pnpm typecheck:lib && pnpm typecheck:demo",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "sample": "node scripts/generate-sample.mjs",
    "inspect:sample": "node scripts/inspect-pptx.mjs generated/jang-pptx-engine-sample.pptx",
    "pack:check": "node scripts/pack-check.mjs",
    "sample:design": "node scripts/generate-design-sample.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "framer-motion": "^12.42.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
