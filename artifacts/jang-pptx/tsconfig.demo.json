{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "incremental": false
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/demo/**/*.ts",
    "src/renderer/**/*.ts",
    "src/schema/**/*.ts",
    "src/template/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["src/tests/**/*", "src/components/**/*", "src/hooks/**/*", "src/pages/**/*", "src/lib/**/*", "dist", "node_modules"]
}
