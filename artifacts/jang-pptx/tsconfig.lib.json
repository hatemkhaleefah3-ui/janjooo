{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "incremental": false
  },
  "include": [
    "src/index.ts",
    "src/renderer/**/*.ts",
    "src/schema/**/*.ts",
    "src/schema/**/*.json",
    "src/template/**/*.ts"
  ],
  "exclude": ["src/tests/**/*", "dist", "node_modules"]
}
